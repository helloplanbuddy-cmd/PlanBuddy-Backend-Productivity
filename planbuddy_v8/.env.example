# ============================================================
# PlanBuddy Backend — Environment Variables (Production 3.0)
# Copy to .env and fill in real values. NEVER commit .env to git.
# ============================================================

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# ─── Database ────────────────────────────────────────────────
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=postgresql://planbuddy:password@localhost:5432/planbuddy_prod

# ─── Redis ───────────────────────────────────────────────────
# Format: redis://[:password@]host:port[/db]
# For TLS (Render Redis, Upstash): rediss://...
REDIS_URL=redis://localhost:6379
# Optional: separate URL for BullMQ queues (defaults to REDIS_URL)
# REDIS_QUEUE_URL=redis://localhost:6379/1

# ─── Authentication ──────────────────────────────────────────
# Must be at least 64 characters, cryptographically random.
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING_AT_LEAST_64_CHARS_FOR_PROD
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=30d
MAX_SESSION_LIMIT=5
MAX_SESSION_LIFETIME=30d
# ─── Razorpay ────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_XXXXXXXXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
RAZORPAY_WEBHOOK_SECRET=XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGINS=https://planbuddy.in,https://www.planbuddy.in,https://app.planbuddy.in

# ─── Email ───────────────────────────────────────────────────
RESEND_API_KEY=re_XXXXXXXXXXXXXXXXXXXXXXXXXXXX
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# SMTP_SECURE=false
FROM_EMAIL=noreply@planbuddy.in
FROM_NAME=PlanBuddy
SUPPORT_EMAIL=support@planbuddy.in

# ─── Logging ─────────────────────────────────────────────────
# Pino levels: trace, debug, info, warn, error, fatal
LOG_LEVEL=info
# Set to "true" to enable pretty-print (dev only)
LOG_PRETTY=false

# ─── Metrics ─────────────────────────────────────────────────
METRICS_ALLOWED_IPS=127.0.0.1,::1

# ─── Idempotency ─────────────────────────────────────────────
IDEMPOTENCY_TTL_HOURS=24

# ─── BullMQ / Queue ──────────────────────────────────────────
# Number of concurrent jobs per worker
WORKER_CONCURRENCY=5
# Enable BullMQ board UI (set to false in prod unless behind auth)
BULLMQ_BOARD_ENABLED=false

# ─── Redis Cache TTLs ────────────────────────────────────────
# JWT revocation cache TTL (seconds) — shorter = more secure
REDIS_JTI_CACHE_TTL=60
# User active-status cache TTL (seconds)
REDIS_USER_ACTIVE_TTL=60
